{
  "name": "lendloop",
  "version": "0.1.0",
  "private": true,
  "description": "Neighbourhood tool-lending board. Next.js + Clerk + Convex + n8n.",
  "scripts": {
    "setup": "cp -n .env.example .env.local; npm i",
    "dev": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "next dev",
    "dev:backend": "convex dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "convex run seed:run",
    "n8n:up": "docker compose up -d n8n",
    "prepare": "husky || true"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.9.23",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@mui/material-nextjs": "^9.5.0",
    "convex": "^1.49.0",
    "convex-helpers": "^0.1.133",
    "date-fns": "^4.4.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "convex-test": "^0.0.66",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.27.0": true
  },
  "type": "module"
}
