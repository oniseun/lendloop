# Copy to n8n/.env. Read by docker compose for the n8n container only.

# Encrypts n8n's credential store. Generate once: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=Europe/London

# Where n8n calls Convex. Local Convex backend: http://host.docker.internal:3211
# Convex cloud: https://<deployment>.convex.site
LENDLOOP_CONVEX_SITE_URL=http://host.docker.internal:3211
LENDLOOP_APP_URL=http://localhost:3000

# HMAC secrets. Must match the Convex deployment env:
#   LENDLOOP_N8N_TO_CONVEX_SECRET == N8N_TO_CONVEX_SECRET
#   LENDLOOP_CONVEX_TO_N8N_SECRET == CONVEX_TO_N8N_SECRET
# Generate each with: openssl rand -hex 32
LENDLOOP_N8N_TO_CONVEX_SECRET=
LENDLOOP_CONVEX_TO_N8N_SECRET=

# email = send through the "LendLoop SMTP" credential (Mailpit locally)
# mock  = log a masked line in the n8n execution instead
LENDLOOP_NOTIFY_CHANNEL=email
LENDLOOP_EMAIL_FROM=LendLoop <noreply@lendloop.local>
# Failed runs are emailed here (leave empty to only log them).
LENDLOOP_ALERT_EMAIL=ops@lendloop.local

# Imported into n8n's encrypted credential store at boot.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
