# Docker:  cp .env.example .env        then `docker compose up --build`
# Manual:  cp .env.example .env.local  (npm run setup does it)
# Every value is optional for Docker.

# Clerk (dashboard -> API keys). Docker: leave both empty and a Clerk
# keyless dev app is created for you (the claim link is printed in the
# convex-init logs). Fill in BOTH to use your own Clerk app.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Comma-separated emails that get the admin role on first sign-in.
ADMIN_EMAILS=

# ---------------------------------------------------------------------
# Docker only
# ---------------------------------------------------------------------
# n8n editor login (http://localhost:5678), created on first boot.
# Local-only default; change it if the port is reachable by others.
N8N_OWNER_EMAIL=admin@lendloop.local
N8N_OWNER_PASSWORD=LendLoop-local-1
# email = send through Mailpit (http://localhost:8025), mock = log only
LENDLOOP_NOTIFY_CHANNEL=email

# ---------------------------------------------------------------------
# Manual setup only
# ---------------------------------------------------------------------
# `npx convex dev` adds CONVEX_DEPLOYMENT and NEXT_PUBLIC_CONVEX_URL.
NEXT_PUBLIC_CONVEX_URL=

# Server secrets do NOT go here. They live on the Convex deployment:
#
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://<your-app>.clerk.accounts.dev
#   npx convex env set ADMIN_EMAILS you@example.com
#   npx convex env set N8N_REQUEST_WEBHOOK_URL http://localhost:5678/webhook/lendloop/request-events
#   npx convex env set CONVEX_TO_N8N_SECRET <openssl rand -hex 32>
#   npx convex env set N8N_TO_CONVEX_SECRET <openssl rand -hex 32>
#
# and in n8n/.env for the n8n container (see n8n/.env.example).
